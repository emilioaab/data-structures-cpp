#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define MAX_WORD_LENGTH 999
typedef struct Node {
    char word[MAX_WORD_LENGTH];
    struct Node* next;
} Node;
void handle_allocation_failure(void *ptr);
Node *allocate_memory();
void copy_word_to_node(Node *node, char *word);
void set_next_to_null(Node *node);
Node *allocate_node(char *word);
Node *get_last_node(Node **head);
void print_node_word(Node *node);
void print_linked_list(Node *head);
void add_node_at_end(Node **head, char *word);
void init_stack(Node **stack_top);
void push(Node **top, char *word);
int is_stack_empty(Node *top);
void find_node(Node **dictionary, char *word, Node **current_node, Node **previous_node);
void update_links(Node **dictionary, Node *current_node, Node *previous_node);
void remove_node(Node **dictionary, Node *current_node, Node *previous_node);
void pop(Node **dictionary, char *word);
void init_queue(Node **front, Node **rear);
int verify_queue_empty(Node *front);
void enqueue(Node **front, Node **rear, char *word);
int is_queue_empty(Node **front);
void get_word_from_node(Node **front, char *word);
void update_queue(Node **front, Node **rear);
void dequeue(Node **front, Node **rear, char *word);
Node* get_next_node(Node *node);
void free_node(Node *node);
void free_linked_list(Node *head);
int get_string_length(const char *word);
int compare_string_length(int len1, int len2);
int compare_characters(const char *word1, const char *word2, int index);
int compare_string_lengths(int len1, int len2);
int count_character_differences(const char *word1, const char *word2, int len);
int differs_by_one_char(const char *word1, const char *word2);
Node* get_next_visited_word(Node *node);
int compare_visited_word(Node *node, char *word);
int check_word_visited(Node *visitedWords, char *word);
int are_words_same(const char *initial_word, const char *final_word);
void print_and_return_if_same(const char *initial_word, const char *final_word);

void generate_word_ladder(char *initial_word, char *final_word, Node *dictionary);