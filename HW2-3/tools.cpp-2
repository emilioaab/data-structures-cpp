#include "tools.h"

void printMenuItems(Item** items, int itemsSize)
{
    cout << "<<< Menu >>>" << endl;
    for (int i = 0; i < itemsSize; i++)
    {
        cout << i + 1 << ". " << items[i]->getName() << "/ ";
        cout << items[i]->getPrice() << "$/ ";
        cout << items[i]->getCalories() << "cal\n";
    }
}

Order* minCalories(Restaurant& res)
{
    int index = 0, minCal = res.getOrder(0)->getCalories();
    for (int i = 0; i < res.getOrderSize(); i++)
    {
        if (res.getOrder(i)->getCalories() < minCal) {
            index = i;
            minCal = res.getOrder(index)->getCalories();
        }
    }

    return res.getOrder(index);
}
