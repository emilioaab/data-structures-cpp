#pragma once
#include "Item.h"
#include "Time.h"

class Order
{
    string _client;
    Time _orderTime;
    Item **_items;
    int _itemsSize;

public:
    Order(string client); //Time use default time.
    Order(string client, Time time);
    Order(string client, Time time, Item** menu, int menuSize, int* indexList, int sizeIndexes);////
    Order(string client, Time time, Item** menu, int menuSize, int index);
    Order(const Order&); //copying ctor
    ~Order();

    //getters & setters

    // Setters and Getters
    string getClientName() const { return _client; }
    void setClientName(const string name) { this->_client = name; }
    Time getOrderTime() const { return _orderTime; }
    void setOrderTime(const Time& time) { this->_orderTime = time; }
    int getItemsSize() const { return _itemsSize; }
    void setName(const string name) { this->_client = name; };

    //Funcs
    void addItems(Item** menu, int menuSize, int* indexList, int sizeIndexes);
    void addItems(Item** menu, int menuSize, int index);
    void removeItem(int index);
    double getTotal() const;
    int getCalories() const;
    string toString() const;


};

