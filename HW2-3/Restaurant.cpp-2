#include "Restaurant.h"
#include <iostream>
#include "tools.h"

Restaurant::Restaurant(string restaurnatName, Item** itemsList, int itemsSize)
{
    this->_resName = restaurnatName;
    this->_menu = new Item * [itemsSize];
    for (int i = 0; i < itemsSize; i++)
    {
        _menu[i] = new Item(*(itemsList[i]));
    }
    _menuSize = itemsSize;

    _orders = nullptr;

    _orderSize = 0;


}

Restaurant::Restaurant(const Restaurant& other)
{
    this->_resName = other._resName;
    this->_menuSize = other._menuSize;
    this->_menu = new Item * [_menuSize];
    for (int i = 0; i < _menuSize; i++)
    {
        _menu[i] = new Item(*(other._menu[i]));
    }
    _orders = nullptr;

    _orderSize = 0;
}

Restaurant::~Restaurant()
{
    if (_menu) {
        for (int i = 0; i < _menuSize; i++)
        {
            delete _menu[i];
        }
        delete[] _menu;
    }

    if (_orders) {
        for (int i = 0; i < _orderSize; i++)
        {
            delete _orders[i];

        }
        delete[] _orders;
    }
}

void Restaurant::addMenuItem(Item item)
{
    Item** temp = new Item * [this->_menuSize + 1];
    for (int i = 0; i < _menuSize; i++)
    {
        temp[i] = this->_menu[i];
    }

    temp[_menuSize] = new Item(item);

    if (_menu)
        delete[] _menu;
    _menu = temp;
    _menuSize++;

}

void Restaurant::removeMenuItem(int index)
{
    if (1 <= index && index <= _menuSize)
    {
        Item** temp = new Item * [this->_menuSize - 1];
        for (int i = 0; i < index - 1; i++)
        {
            temp[i] = this->_menu[i];
        }
        for (int i = index; i < _menuSize; i++)
        {
            temp[i - 1] = this->_menu[i];
        }

        if (_menu)
            delete[] _menu;

        this->_menu = temp;
        _menuSize--;
    }
}

void Restaurant::addOrders(Order** order, int orderSize)
{
    Order** temp = new Order * [this->_orderSize + orderSize];
    for (int i = 0; i < _orderSize; i++)
    {
        temp[i] = this->_orders[i];
    }
    for (int i = 0; i < orderSize; i++)
    {
        temp[_orderSize + i] = order[i];
    }
    if (_orders)
        delete[] _orders;
    _orders = temp;
    _orderSize += orderSize;
}

void Restaurant::addOrders(Order* order)
{
    Order** temp = new Order * [this->_orderSize + 1];
    for (int i = 0; i < _orderSize; i++)
    {
        temp[i] = this->_orders[i];
    }
    temp[_orderSize] = order;

    if (_orders)
        delete[] _orders;

    _orders = temp;
    _orderSize++;
}

void Restaurant::printMenu() const
{
    printMenuItems(_menu, _menuSize);
}

void Restaurant::printOrders() const
{
    cout << "orders(";
    for (int i = 0; i < _orderSize - 1; i++)
    {
        cout << _orders[i]->toString() + ", ";
    }
    if (this->_orderSize)
        cout << _orders[_orderSize - 1]->toString();
    cout << ")]";
}

string Restaurant::toString() const
{
    string str = "Restaurant[\'";
    str += _resName + "\', " + " menu(";
    for (int i = 0; i < _menuSize - 1; i++)
    {
        str += _menu[i]->toString() + ", ";

    }
    str += _menu[_menuSize - 1]->toString() + ", orders(";
    for (int i = 0; i < _orderSize - 1; i++)
    {
        str += _orders[i]->toString() + ", ";
    }
    if (this->_orderSize)
        str += _orders[_orderSize - 1]->toString();
    str += ")]";
    return str;
}
