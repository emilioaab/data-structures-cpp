#pragma once
#include <string>

using namespace std;

class Item {
private:
    static int objectCount; // Static variable to keep track of the number of objects
    const int _objectId; // Object ID number
    string _itemName; // Name of the item
    double _itemPrice; // Price of the item
    int _itemCalories; // Calories of the item

public:
    // Constructors
    Item(string _itemName, double _itemPrice, int _itemCalories); // Default constructor
    Item(string _itemName);
    Item(const Item& other); // Copy constructor

    // Destructor
    ~Item();

    // Getter methods
    int getId() const;
    string getName() const;
    double getPrice() const;
    int getCalories() const;
    void setName(string _itemName);
    void setPrice(double _itemPrice);
    void setCalories(int _itemCalories);

    //    // Static function to get the total number of objects created
    //    static int getObjectCount();

    // Functions to show object details
    string toFullString() const; // Show object as a string with id number
    string toString() const; // Show object as a string without the id number
//    string toOrderString() const;

    // Function to compare objects and return the one with minimal calories
    const Item& compare(const Item& other) const;

    // Static function to get the total number of items created from the class
    static int getNumOfItems();

    //    static void printMenuItems(Item *menu[], int size);
};

