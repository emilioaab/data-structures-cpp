#include "Item.h"

// Initialize the static member variable objectCount to 0
int Item::objectCount = 0;

Item::Item(string itemName, double itemPrice, int itemCalories) :_objectId(++objectCount) {

    this->_itemName = itemName;
    this->_itemPrice = itemPrice;
    this->_itemCalories = itemCalories;
}


Item::Item(string itemName) : _objectId(++objectCount) {
    this->_itemName = itemName;
    this->_itemPrice = 0;
    this->_itemCalories = 0;
}

// Copy constructor
Item::Item(const Item& other) : _objectId(++objectCount) {
    this->_itemName = other._itemName;
    this->_itemPrice = other._itemPrice;
    this->_itemCalories = other._itemCalories;
}

// Destructor
Item::~Item() {

}

// Getter method for id
int Item::getId() const {
    return this->_objectId;
}

// Getter method for name
string Item::getName() const {
    return this->_itemName;
}

// Getter method for price
double Item::getPrice() const {
    return this->_itemPrice;
}

// Getter method for calories
int Item::getCalories() const {
    return this->_itemCalories;
}

// Setter method for name
void Item::setName(string itemName) {
    this->_itemName = itemName;
}

// Setter method for price
void Item::setPrice(double itemPrice) {
    this->_itemPrice = itemPrice;
}

// Setter method for calories
void Item::setCalories(int itemCalories) {
    this->_itemCalories = itemCalories;
}


// Function to show object details as a string with id number
string Item::toFullString() const {
    return "Item(" + to_string(_objectId) +
           "," + _itemName + "," +
           to_string(_itemPrice) + "," + to_string(_itemCalories) + ")";


}

// Function to show object details as a string without the id number
string Item::toString() const {
    return "Item(" + _itemName + "," +
           to_string(_itemPrice) + "," + to_string(_itemCalories) + ")";
}

// Function to compare objects and return the one with minimal calories
const Item& Item::compare(const Item& other) const {
    return this->_itemCalories < other._itemCalories ? *this : other;
}

// Static function to get the total number of items created from the class
int Item::getNumOfItems() {
    return Item::objectCount;
}

