#pragma once
#include "Order.h"

class Restaurant
{
    string _resName;
    Item** _menu;
    Order** _orders;
    int _menuSize;
    int _orderSize;


public:

    Restaurant(string restaurnatName, Item** itemsList, int itemsSize);
    Restaurant(const Restaurant& other);
    ~Restaurant();


    string getResName()const{ return _resName; }
    int getOrderSize() const { return _orderSize; }
    Order* getOrder(int index) const { return (_orders[index]); }
    int getMenuSize() const { return _menuSize; }
    Item** getMenu() { return _menu; }
    void setName( const string resName)  { this->_resName = resName; }

    //methods
    void addMenuItem(Item item);
    void removeMenuItem(int index);
    void addOrders(Order** order, int orderSize);
    void addOrders(Order* order);
    void printMenu()const;
    void printOrders()const;
    string toString()const;

};

